# Leave empty to use the explicitly labelled local demo snapshot.
# When a backend exists, point this to its public origin, for example:
# VITE_API_BASE_URL=http://127.0.0.1:8001
VITE_API_BASE_URL=
# SSR requests need the backend origin too. These URLs contain no credentials.
# VITE_API_UPSTREAM_URL=http://127.0.0.1:8001
VITE_API_UPSTREAM_URL=

# Copy to .env.production. This example is safe to commit; never commit the filled file.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
AI_RADAR_ADMIN_TOKEN=replace-with-an-independent-bootstrap-token
AI_RADAR_JWT_SECRET=replace-with-at-least-32-random-bytes
AI_RADAR_ACCESS_TOKEN_MINUTES=30
AI_RADAR_API_PORT=8000
AI_RADAR_WORKER_INTERVAL_SECONDS=900

# Keep demo until real collection, extraction, review, and quality gates are operational.
AI_RADAR_DATA_MODE=demo
AI_RADAR_CORS_ORIGINS=https://your-frontend.example

# Comma-separated, reviewed official hosts only. Empty disables automatic fetching.
AI_RADAR_FETCH_ALLOWED_HOSTS=

# Optional OpenAI-compatible structured extraction provider.
AI_RADAR_EXTRACTION_API_URL=
AI_RADAR_EXTRACTION_API_KEY=
AI_RADAR_EXTRACTION_MODEL=

# Optional email delivery. Digest messages remain queued when these are empty.
AI_RADAR_SMTP_HOST=
AI_RADAR_SMTP_PORT=587
AI_RADAR_SMTP_USERNAME=
AI_RADAR_SMTP_PASSWORD=
AI_RADAR_SMTP_FROM=
AI_RADAR_SMTP_STARTTLS=true
AI_RADAR_DIGEST_TIMEZONE=Asia/Shanghai

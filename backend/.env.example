# Development bootstrap token. Generate a long random value and never commit it.
AI_RADAR_ADMIN_TOKEN=replace-with-a-long-random-value
AI_RADAR_JWT_SECRET=replace-with-at-least-32-random-bytes
AI_RADAR_ACCESS_TOKEN_MINUTES=30

# The generated seed is demo data. Keep this as demo until real ingestion is connected.
AI_RADAR_DATA_MODE=demo
AI_RADAR_ENVIRONMENT=development

# Comma-separated browser origins allowed to read the API.
AI_RADAR_CORS_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:4181,http://127.0.0.1:4182,http://localhost:3000,http://localhost:5173,http://localhost:4181,http://localhost:4182

# Only these official-source hostnames may be fetched automatically.
# Keep empty to disable network collection.
AI_RADAR_FETCH_ALLOWED_HOSTS=openai.com,anthropic.com,ai.google.dev
AI_RADAR_FETCH_MAX_BYTES=2000000

# Optional OpenAI-compatible structured extraction endpoint. If omitted,
# collection and manual review still work, but the extraction endpoint returns 503.
# AI_RADAR_EXTRACTION_API_URL=https://provider.example/v1/chat/completions
# AI_RADAR_EXTRACTION_API_KEY=replace-with-provider-secret
# AI_RADAR_EXTRACTION_MODEL=replace-with-structured-output-model

# Optional SMTP delivery. Digests are safely queued without this configuration.
# AI_RADAR_SMTP_HOST=smtp.example.com
# AI_RADAR_SMTP_PORT=587
# AI_RADAR_SMTP_USERNAME=apikey-or-user
# AI_RADAR_SMTP_PASSWORD=replace-with-secret
# AI_RADAR_SMTP_FROM=AI Radar <radar@example.com>
# AI_RADAR_SMTP_STARTTLS=true

# Optional overrides:
# AI_RADAR_DATABASE_URL=sqlite:///D:/path/to/ai_radar.db
# AI_RADAR_DATABASE_URL=postgresql+psycopg://ai_radar:password@localhost:5432/ai_radar
# AI_RADAR_SEED_SNAPSHOT=D:/path/to/demo_snapshot.json

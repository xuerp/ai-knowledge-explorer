      },
      "patterns": ["文档解析", "文档抽取", "文档理解", "图像输入", "图片输入", "document input", "document processing", "document understanding", "document extraction", "image input", "PDF", "OCR"]
    },
    "persistent-state": {
      "name": {
        "zh": "持久状态与长运行",

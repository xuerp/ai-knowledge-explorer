{
  "version": 1,
  "interpretation": {
    "nativeRetrieval": "(?:自带|内置|原生).{0,8}(?:检索|知识库|文件搜索)|(?:built.in|native).{0,12}(?:retrieval|file search|knowledge base)",
    "clauseSeparator": "[，,。；;!?！？\\n]+",
    "negativeClause": "^(?:我(?:们)?|本次)?\\s*(?:不要|不做|不需要|无需|不想|不用|不考虑|no\\b|not required\\b|do not\\b|don't\\b)|\\b(?:not required|not needed|not available|unsupported)\\b|(?:不需要|无需|不支持)$",
    "modelScope": "底层模型|回答用的.{0,8}模型|(?:编程|代码|文本|写作)模型|模型\\s*API|(?:选择|选个|选一个|选|接入|换).{0,12}模型|(?:通过|接|接入|接受).{0,6}(?:云\\s*)?API|\\b(?:model API|coding API|text model|language model)\\b",
    "imageInput": "(?:票据|发票|文档|合同).{0,8}(?:照片|图片|扫描件)|(?:图片|照片|扫描件).{0,12}(?:输入|读取|识别|提取)|(?:支持|要求)(?:图片|图像)(?:输入)?|图像输入|image input|accept images",
    "textOnly": "(?:已(?:经)?转成|只处理|仅处理|输入(?:是|为)?|输入材料(?:是|为)?).{0,6}(?:纯文本|文本)|text.only|plain text input"
  },
  "scenarios": [
    {
      "id": "knowledge-workspace",
      "name": {
        "zh": "文档问答应用与知识库平台",
        "en": "Document QA application and knowledge platform"
      },
      "patterns": [
        "知识库",
        "文档问答",
        "企业问答",
        "检索增强",
        "RAG",
        "knowledge base",
        "document question",
        "retrieval augmented"
      ],
      "taskType": "knowledge-product",
      "scopeAlternatives": { "model-api": "knowledge-assistant" },
      "intentPatterns": [
        "(?:文档|PDF|Word|手册|规章).{0,100}(?:提问|问答|回答|查出处)",
        "(?:检索片段|检索结果|retrieved passages).{0,100}(?:回答|生成答案|answer)",
        "问答网站"
      ],
      "features": ["knowledge-ingestion", "knowledge-retrieval", "source-citations"],
      "optionalFeatures": ["workspace-permissions"],
      "checks": {
        "zh": [
          "先用少量授权文档搭建试点，核对原文引用与无依据拒答",
          "工作区成员权限不等于终端用户逐文档隔离，单独验证越权访问",
          "核对模型、嵌入服务的数据去向以及部署维护成本"
        ],
        "en": [
          "Pilot a small authorized document set; verify citations and abstention",
          "Workspace membership is not per-document end-user isolation; test unauthorized access",
          "Check model and embedding data destinations and deployment maintenance cost"
        ]
      }
    },
    {
      "id": "knowledge-assistant",
      "name": {
        "zh": "知识库与文档问答",
        "en": "Knowledge and document answers"
      },
      "patterns": [
        "知识库",
        "文档问答",
        "企业问答",
        "检索增强",
        "RAG",
        "knowledge base",
        "document question",
        "retrieval augmented"
      ],
      "taskType": "model-api",
      "intentPatterns": [
        "(?:文档|PDF|Word|手册|规章).{0,100}(?:提问|问答|回答|查出处)",
        "(?:检索片段|检索结果|retrieved passages).{0,100}(?:回答|生成答案|answer)",
        "问答网站"
      ],
      "features": ["text-generation"],
      "checks": {
        "zh": ["用真实文档检查答案与出处是否一致", "明确文档是否允许发送到外部服务"],
        "en": [
          "Check answer and source agreement on real documents",
          "Clarify whether documents may leave your environment"
        ]
      }
    },
    {
      "id": "career-assistant",
      "name": {
        "zh": "求职资料与岗位匹配助手",
        "en": "Career document and job matching assistant"
      },
      "patterns": ["求职", "简历", "岗位匹配", "resume", "job search", "career assistant"],
      "intentPatterns": ["履历|职位说明|招聘要求|候选人.{0,12}(?:工作经历|技能|学历)"],
      "taskType": "model-api",
      "features": ["text-generation", "structured-output"],
      "checks": {
        "zh": [
          "明确先处理简历、岗位匹配还是面试练习",
          "用脱敏简历与岗位描述检查信息抽取、匹配理由和事实保真"
        ],
        "en": [
          "Choose resume processing, job matching or interview practice first",
          "Test extraction, matching explanations and fidelity on anonymized resumes and job descriptions"
        ]
      }
    },
    {
      "id": "coding-workspace",
      "name": {
        "zh": "代码编辑与开发工作台",
        "en": "Code editing and development workspace"
      },
      "patterns": [
        "编码工具",
        "编程工具",
        "代码编辑器",
        "终端编程",
        "IDE",
        "coding product",
        "coding assistant",
        "code editor",
        "coding workspace"
      ],
      "taskType": "coding-product",
      "scopeAlternatives": { "model-api": "coding-model" },
      "intentPatterns": [
        "(?:直接)?改文件|跑测试|修\\s*bug|提交补丁|读项目|开发助手|仓库.{0,40}(?:测试|修复|修改)"
      ],
      "features": ["code-editing", "tool-use"],
      "optionalFeatures": ["file-editing", "test-execution"],
      "checks": {
        "zh": ["明确需要 IDE、终端还是云端任务入口", "在现有仓库检查补丁、测试与审批边界"],
        "en": [
          "Choose an IDE, terminal or cloud task interface",
          "Check patches, tests and approval boundaries on your repository"
        ]
      }
    },
    {
      "id": "coding-model",
      "intentPatterns": ["生成补丁|产出.{0,20}(?:代码|补丁)|编程\\s*API|代码助手"],
      "name": {
        "zh": "代码生成与软件工程模型",
        "en": "Coding and software engineering model"
      },
      "patterns": [
        "代码生成",
        "编程模型",
        "代码模型",
        "code generation",
        "coding model",
        "coding API"
      ],
      "taskType": "model-api",
      "features": ["code-generation", "tool-use"],
      "checks": {
        "zh": ["明确补全、代码修改还是自主修复任务", "用相同仓库任务与工具配置比较成功率"],
        "en": [
          "Choose completion, code changes or autonomous repair",
          "Compare success on the same repository tasks and tool setup"
        ]
      }
    },
    {
      "id": "agent-orchestration",
      "intentPatterns": [
        "串联.{0,40}(?:搜索|接口|工具)",
        "(?:智能体|agent).{0,20}(?:流程|工作流)",
        "(?:流程|工作流).{0,40}(?:中断|恢复|审批)"
      ],
      "name": {
        "zh": "Agent 应用编排",
        "en": "Agent application orchestration"
      },
      "patterns": [
        "Agent开发",
        "Agent 开发",
        "智能体开发",
        "Agent框架",
        "Agent 框架",
        "多智能体",
        "有状态",
        "长运行",
        "agent development",
        "agent framework",
        "multi-agent",
        "stateful",
        "orchestration"
      ],
      "taskType": "agent-development",
      "features": ["orchestration", "tool-use"],
      "checks": {
        "zh": [
          "明确是否需要持久状态、人工审批和恢复",
          "在中断恢复、工具失败和权限隔离场景验证编排"
        ],
        "en": [
          "Clarify persistent state, human approval and recovery needs",
          "Test orchestration under interruption, tool failure and permission isolation"
        ]
      },
      "optionalFeatures": ["persistent-state", "human-approval", "failure-recovery"]
    },
    {
      "id": "document-extraction",
      "intentPatterns": [
        "(?:合同|发票|票据|工单|文档|表格|文件).{0,100}(?:JSON|字段)",
        "(?:提取|抽取|读取|抽成|转成).{0,50}(?:JSON|固定字段)"
      ],
      "name": {
        "zh": "文档信息抽取",
        "en": "Document information extraction"
      },
      "patterns": [
        "信息抽取",
        "文档提取",
        "批量提取",
        "提取固定字段",
        "字段抽取",
        "extract fields",
        "发票",
        "OCR",
        "document extraction",
        "invoice",
        "extract data"
      ],
      "taskType": "model-api",
      "features": ["structured-output", "document-input"],
      "checks": {
        "zh": ["明确输入为文本、扫描件还是图片", "核对字段准确率、缺失字段与格式稳定性"],
        "en": [
          "Specify text, scans or images as input",
          "Measure field accuracy, missing fields and format stability"
        ]
      }
    },
    {
      "id": "general-text",
      "intentPatterns": ["起草|改写|润色|撰写|\\bdraft\\b|\\brewrite\\b|customer replies"],
      "name": {
        "zh": "文本生成与对话",
        "en": "Text generation and conversation"
      },
      "patterns": [
        "文本生成",
        "写作",
        "客服",
        "对话",
        "text generation",
        "writing",
        "chatbot",
        "customer support"
      ],
      "taskType": "model-api",
      "features": ["text-generation"],
      "checks": {
        "zh": ["说明输出面向谁，以及怎样判定结果合格", "用同一组实际请求检查准确性和可接受表达"],
        "en": [
          "Specify the audience and acceptance criteria",
          "Check accuracy and acceptable wording on the same real requests"
        ]
      }
    }
  ],
  "features": {
    "knowledge-ingestion": {
      "name": { "zh": "文档导入与解析", "en": "Document ingestion" },
      "patterns": ["知识库文档导入", "knowledge ingestion"]
    },
    "knowledge-retrieval": {
      "name": { "zh": "知识库检索与应用接入", "en": "Knowledge retrieval and app integration" },
      "patterns": ["知识库检索", "knowledge retrieval"]
    },
    "source-citations": {
      "name": { "zh": "回答引用与来源展示", "en": "Answer citations and sources" },
      "patterns": ["原文引用", "citation and attribution"]
    },
    "workspace-permissions": {
      "name": { "zh": "工作区成员访问控制", "en": "Workspace-member access control" },
      "patterns": ["权限控制", "成员权限", "访问控制", "access control", "workspace permissions"]
    },
    "file-editing": {
      "requestPatterns": ["改文件|提交补丁|修改源文件"],
      "name": { "zh": "编辑仓库文件", "en": "Edit repository files" },
      "supersedes": ["code-editing"],
      "patterns": [
        "编辑文件",
        "编辑代码",
        "edit files",
        "edits files",
        "edit code",
        "editing files"
      ]
    },
    "test-execution": {
      "requestPatterns": ["跑测试|重跑测试|执行测试"],
      "name": { "zh": "运行测试", "en": "Run tests" },
      "supersedes": ["tool-use"],
      "patterns": [
        "运行测试",
        "执行测试",
        "运行和测试代码",
        "run tests",
        "runs tests",
        "running tests",
        "execute tests",
        "run and test code"
      ]
    },
    "text-generation": {
      "name": {
        "zh": "文本与对话用途",
        "en": "Text and conversation use"
      },
      "patterns": [
        "文本",
        "对话",
        "写作",
        "text",
        "chat",
        "conversation",
        "writing",
        "reasoning",
        "推理"
      ]
    },
    "structured-output": {
      "name": {
        "zh": "结构化输出",
        "en": "Structured output"
      },
      "patterns": ["结构化输出", "JSON schema", "structured output", "schema-constrained"]
    },
    "retrieval": {
      "name": {
        "zh": "检索与来源整合",
        "en": "Retrieval and source integration"
      },
      "patterns": ["检索", "搜索", "retrieval", "search", "RAG"]
    },
    "code-generation": {
      "name": {
        "zh": "代码生成用途",
        "en": "Code generation use"
      },
      "patterns": ["代码", "编程", "coding", "code", "software engineering"]
    },
    "code-editing": {
      "name": {
        "zh": "代码编辑工作流",
        "en": "Code editing workflow"
      },
      "patterns": [
        "代码编辑",
        "编辑文件",
        "多文件编辑",
        "code edit",
        "editing",
        "edit files",
        "patch",
        "IDE",
        "software engineer",
        "软件工程"
      ]
    },
    "tool-use": {
      "name": {
        "zh": "工具接入与执行",
        "en": "Tool integration and execution"
      },
      "patterns": ["工具", "测试", "命令", "tool", "test", "command", "terminal", "MCP", "handoff"]
    },
    "orchestration": {
      "name": {
        "zh": "Agent 编排",
        "en": "Agent orchestration"
      },
      "patterns": [
        "编排",
        "有状态",
        "协作",
        "Agent",
        "agent",
        "orchestration",
        "runtime",
        "Flows",
        "guardrail"
      ]
    },
    "document-input": {
      "name": {
        "zh": "文档处理用途",
        "en": "Document processing use"
      },
      "patterns": [
        "文档解析",
        "文档抽取",
        "文档理解",
        "图像输入",
        "图片输入",
        "document input",
        "document processing",
        "document understanding",
        "document extraction",
        "image input",
        "PDF",
        "OCR"
      ]
    },
    "persistent-state": {
      "requestPatterns": ["中断后.{0,12}(?:续跑|继续)|从上一步继续"],
      "name": {
        "zh": "持久状态与长运行",
        "en": "Persistent state and long-running work"
      },
      "patterns": [
        "有状态",
        "持久状态",
        "长运行",
        "stateful",
        "persistent state",
        "long-running",
        "durable execution"
      ]
    },
    "human-approval": {
      "requestPatterns": ["人(?:工)?(?:点)?确认|审批后|审批再|人工审核"],
      "name": {
        "zh": "人工审批",
        "en": "Human approval"
      },
      "patterns": [
        "人工审批",
        "人工介入",
        "human-in-the-loop",
        "human approval",
        "human intervention"
      ]
    },
    "failure-recovery": {
      "requestPatterns": ["中断后.{0,12}(?:续跑|继续)|从上一步继续"],
      "name": {
        "zh": "中断与失败恢复",
        "en": "Interruption and failure recovery"
      },
      "patterns": [
        "中断恢复",
        "失败恢复",
        "断点恢复",
        "checkpoint",
        "failure recovery",
        "resumable",
        "resume execution"
      ]
    }
  }
}

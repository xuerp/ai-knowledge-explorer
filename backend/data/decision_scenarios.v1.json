      "patterns": ["代码", "编程", "coding", "code", "software engineering"]
    },
    "code-editing": {
      "name": {
        "zh": "代码编辑工作流",
        "en": "Code editing workflow"
      },
      "patterns": [
        "代码编辑",
        "编辑文件",
        "多文件编辑",
        "code edit",
        "editing",
        "edit files",
        "patch",
        "IDE",
        "software engineer",
        "软件工程"
      ]
    },
    "tool-use": {
      "name": {

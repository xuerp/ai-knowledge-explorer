  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lovable.dev/vite-tanstack-config": "^2.15.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",

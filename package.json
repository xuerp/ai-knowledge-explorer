    "check:decision-layout": "node scripts/check-decision-layout.mjs",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "prepare:cloudflare:staging": "node scripts/prepare-cloudflare-deploy.mjs",
    "verify:cloudflare:staging": "node scripts/verify-staging-build.mjs",
    "verify:staging-release": "node scripts/wait-staging-release.mjs",
    "smoke:staging": "node scripts/smoke-staging.mjs",
    "audit:staging:readonly": "node scripts/audit-staging-readonly.mjs",
    "export:demo-snapshot": "node scripts/export-demo-snapshot.mjs",
    "report:core-models": "node scripts/report-core-model-coverage.mjs --write",
    "check:core-models": "node scripts/report-core-model-coverage.mjs --check",
    "generate:frontend-snapshot": "node scripts/build-frontend-snapshot.mjs --write",
    "generate:icons": "node scripts/build-icons.mjs",
    "check:frontend-snapshot": "node scripts/build-frontend-snapshot.mjs",
    "check:public-env": "node scripts/check-public-env.mjs"

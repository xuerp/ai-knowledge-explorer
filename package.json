{
  "name": "ai-radar",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "overrides": {
    "js-yaml": "^5.4.1",
    "@babel/core": "^7.29.6",
    "baseline-browser-mapping": "^2.11.0",
    "browserslist": "^4.28.7",
